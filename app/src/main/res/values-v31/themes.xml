<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Android 12+: tela de abertura do sistema com fundo Obsidian e o laço do Acerto,
        no lugar do fundo cinza padrão. A saída é animada em MainActivity.
    -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/liquid_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/acerto_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
